# Exit relay example. Read the guidelines before starting:
# https://community.torproject.org/relay/setup/exit/
#
# No default exit policy is added. This minimal policy allows ports 80 and
# 443 and rejects everything else. Adjust it deliberately.
TOR_ROLE=exit
TOR_NICKNAME=ExampleExit
TOR_CONTACT=operator@example.com
TOR_ORPORT=9001
I_UNDERSTAND_EXIT=true
TOR_EXIT_POLICY=accept *:80;accept *:443;reject *:*
TOR_EXIT_IPV6=0
