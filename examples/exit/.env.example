# Required
TOR_ROLE=exit
TOR_NICKNAME=ExampleExit
TOR_CONTACT=operator@example.com
I_UNDERSTAND_EXIT=true
TOR_EXIT_POLICY=accept *:80;accept *:443;reject *:*

# Optional
# TOR_EXIT_IPV6=0
# TOR_ORPORT=9001
# TOR_ADDRESS=
# TOR_BANDWIDTH_RATE=
# TOR_BANDWIDTH_BURST=
# TOR_SANDBOX=1
# TOR_LOG_LEVEL=notice
# TOR_FAMILY_ID=
# TOR_FAMILY_KEY_DIR=/run/secrets
# TOR_MYFAMILY=
# TOR_MYFAMILY_URL=
# TOR_MYFAMILY_REFRESH=1h
# TOR_MYFAMILY_MAX_DROP_PCT=20

# For an exit relay, point tor at a local caching resolver. For Cloudflare
# DNS, write nameserver 1.1.1.1 into the file and set this path.
# TOR_DNS_RESOLV_CONF=/etc/tor/resolv.conf

# Any other torrc option, semicolon-separated.
# TOR_EXTRA_ARGS=MaxMemInQueues 128 MB
