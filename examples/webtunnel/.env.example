# WebTunnel bridge example. The URL must be https and include the secret
# path that the reverse proxy forwards. See nginx.conf.example.
#
# The reverse proxy runs on the host and reaches the bridge through host
# networking at 127.0.0.1:15000.
TOR_ROLE=webtunnel
TOR_NICKNAME=ExampleWT
TOR_CONTACT=operator@example.com
TOR_WEBTUNNEL_URL=https://example.com/secret-path
TOR_WEBTUNNEL_LISTEN=127.0.0.1:15000
TOR_SANDBOX=0
