# Required
TOR_ROLE=webtunnel
TOR_NICKNAME=ExampleWT
TOR_CONTACT=operator@example.com
TOR_WEBTUNNEL_URL=https://example.com/secret-path

# Required for this compose example
TOR_WEBTUNNEL_LISTEN=0.0.0.0:15000

# Optional
# TOR_SANDBOX=0
# TOR_LOG_LEVEL=notice
# TOR_EXTRA_ARGS=MaxMemInQueues 128 MB

# Cloudflare proxy or Tunnel: see README.md and nginx.conf.example.
