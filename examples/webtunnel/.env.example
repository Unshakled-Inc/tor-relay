# WebTunnel bridge example. The URL must be https and include the path
# that the reverse proxy forwards. See nginx.conf.example.
#
# A dedicated domain can use a root path such as https://example.com/.
#
# The compose file publishes the listener on 127.0.0.1:15000 and the PT
# listens on 0.0.0.0:15000 inside the container.
TOR_ROLE=webtunnel
TOR_NICKNAME=ExampleWT
TOR_CONTACT=operator@example.com
TOR_WEBTUNNEL_URL=https://example.com/secret-path
TOR_WEBTUNNEL_LISTEN=0.0.0.0:15000
TOR_SANDBOX=0
