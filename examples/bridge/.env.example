# obfs4 bridge example. Both the ORPort and the obfs4 port must be
# reachable from the internet. See:
# https://community.torproject.org/relay/setup/bridge/
#
# TOR_OBFS4_PORT is unprivileged here. If you use a port below 1024,
# add cap_add: [NET_BIND_SERVICE] to the compose file.
TOR_ROLE=bridge
TOR_NICKNAME=ExampleBridge
TOR_CONTACT=operator@example.com
TOR_ORPORT=9001
TOR_OBFS4_PORT=8443
TOR_BRIDGE_DISTRIBUTION=any
# Tor 0.4.9.17 reports managed proxies are not compatible with Sandbox mode,
# so obfs4 bridges must leave this at 0.
TOR_SANDBOX=0
