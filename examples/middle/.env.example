# Required
TOR_ROLE=middle
TOR_NICKNAME=ExampleRelay
TOR_CONTACT=operator@example.com

# Optional
# TOR_ORPORT=9001
# TOR_ADDRESS=
# TOR_BANDWIDTH_RATE=50 MBytes
# TOR_BANDWIDTH_BURST=100 MBytes
# TOR_SANDBOX=1
# TOR_LOG_LEVEL=notice
# TOR_FAMILY_ID=
# TOR_FAMILY_KEY_DIR=/run/secrets
# TOR_MYFAMILY=
# TOR_MYFAMILY_URL=
# TOR_MYFAMILY_REFRESH=1h
# TOR_MYFAMILY_MAX_DROP_PCT=20
# TOR_EXTRA_ARGS=
# See docs/extra-args.md for the format and examples.

# Debug image only:
# TOR_CONTROL_PORT=9051
